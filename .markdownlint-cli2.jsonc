{
  "noBanner": true,
  "noProgress": true,
  "config": {
    "default": false,
    "no-horizontal-rules": true,
    "MD001": true,
    "MD024": { "siblings_only": true },
    "MD026": true,
    "MD042": true,
    "MD045": true,
    "MD051": true,
    "MD052": true,
    "MD053": true
  },
  "customRules": [".markdownlint-rules/no-horizontal-rules.js"],
  "ignores": [
    "node_modules/**",
    ".git/**",
    ".venv/**",
    ".claude/**",
    "**/archived/**"
  ]
}
