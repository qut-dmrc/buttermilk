{
  "name": "buttermilk-mcp",
  "version": "1.0.0",
  "description": "MCP tools for Buttermilk development workflow",
  "tools": [
    {
      "name": "buttermilk-workflow-check",
      "description": "Validate the 9-step workflow is being followed",
      "inputSchema": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string",
            "enum": ["STOP", "ANALYZE", "PLAN", "TEST", "IMPLEMENT", "DOCUMENT", "VALIDATE", "COMMIT", "REFLECT"],
            "description": "Current workflow step to validate"
          },
          "task_description": {
            "type": "string",
            "description": "Description of the current task"
          }
        },
        "required": ["step"]
      }
    },
    {
      "name": "buttermilk-logs",
      "description": "View and analyze Buttermilk server logs",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": ["tail", "errors", "warnings", "search", "websocket", "follow"],
            "description": "Log viewing mode",
            "default": "tail"
          },
          "lines": {
            "type": "integer",
            "description": "Number of lines to show",
            "default": 50
          },
          "pattern": {
            "type": "string",
            "description": "Search pattern (for search mode)"
          }
        },
        "required": ["mode"]
      }
    },
    {
      "name": "buttermilk-server",
      "description": "Manage Buttermilk API server",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["start", "stop", "status", "health", "flows"],
            "description": "Server action to perform"
          },
          "debug": {
            "type": "boolean",
            "description": "Start in debug mode",
            "default": false
          },
          "flows": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Flows to enable (for start action)",
            "default": ["trans", "zot", "osb"]
          }
        },
        "required": ["action"]
      }
    },
    {
      "name": "buttermilk-test-flow",
      "description": "Test a specific Buttermilk flow",
      "inputSchema": {
        "type": "object",
        "properties": {
          "flow": {
            "type": "string",
            "description": "Flow name to test"
          },
          "prompt": {
            "type": "string",
            "description": "Test prompt/query"
          },
          "mode": {
            "type": "string",
            "enum": ["http", "websocket"],
            "description": "Test mode",
            "default": "http"
          }
        },
        "required": ["flow", "prompt"]
      }
    },
    {
      "name": "buttermilk-config-validate",
      "description": "Validate Buttermilk YAML configurations",
      "inputSchema": {
        "type": "object",
        "properties": {
          "config_path": {
            "type": "string",
            "description": "Path to config file (relative to /src/buttermilk)"
          },
          "check_interpolations": {
            "type": "boolean",
            "description": "Check Hydra interpolations",
            "default": true
          }
        },
        "required": ["config_path"]
      }
    },
    {
      "name": "buttermilk-github-issue",
      "description": "Search and manage GitHub issues for the Buttermilk project",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["search", "create", "link"],
            "description": "Issue action"
          },
          "query": {
            "type": "string",
            "description": "Search query or issue title"
          },
          "body": {
            "type": "string",
            "description": "Issue body (for create action)"
          },
          "labels": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Issue labels"
          }
        },
        "required": ["action", "query"]
      }
    },
    {
      "name": "buttermilk-ws-debug",
      "description": "Debug WebSocket connections to Buttermilk flows",
      "inputSchema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "enum": ["start", "send", "wait", "test", "session", "clear"],
            "description": "Debug command to execute"
          },
          "flow_name": {
            "type": "string",
            "description": "Flow name (for start command)"
          },
          "content": {
            "type": "string",
            "description": "Content to send or query (for start/send commands)"
          },
          "message_type": {
            "type": "string",
            "description": "Message type for send/wait commands",
            "default": "manager_response"
          },
          "pattern": {
            "type": "string",
            "description": "Pattern to search for (wait command)"
          },
          "wait_time": {
            "type": "integer",
            "description": "Time to wait in seconds",
            "default": 10
          }
        },
        "required": ["command"]
      }
    },
    {
      "name": "buttermilk-advanced-debug",
      "description": "Advanced WebSocket debug CLI with full ws_debug_cli.py functionality - requires Buttermilk installation",
      "inputSchema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "enum": ["start", "start-debug", "start-server", "send", "wait", "session", "clear-session", "logs", "list-flows", "test-connection"],
            "description": "Advanced debug command to execute"
          },
          "flow_name": {
            "type": "string",
            "description": "Flow name (for start/start-debug/start-server commands)"
          },
          "query": {
            "type": "string",
            "description": "Query text (for start/start-debug commands)"
          },
          "content": {
            "type": "string",
            "description": "Content to send (for send command)"
          },
          "wait_time": {
            "type": "integer",
            "description": "Time to wait in seconds",
            "default": 5
          },
          "record": {
            "type": "string",
            "description": "Record ID to process (for start/start-debug commands)"
          },
          "criteria": {
            "type": "string",
            "description": "Criteria to use (for start-debug/start-server commands)",
            "default": "hrc"
          },
          "message_type": {
            "type": "string",
            "description": "Message type (for send command)",
            "default": "response"
          },
          "pattern": {
            "type": "string",
            "description": "Pattern to search for (for wait command)"
          },
          "session_id": {
            "type": "string",
            "description": "Session ID to use (for send/wait commands)"
          },
          "lines": {
            "type": "integer",
            "description": "Number of log lines to show (for logs command)",
            "default": 50
          },
          "host": {
            "type": "string",
            "description": "Server host (for start-server command)",
            "default": "localhost"
          },
          "port": {
            "type": "integer",
            "description": "Server port (for start-server command)",
            "default": 8000
          },
          "json_output": {
            "type": "boolean",
            "description": "Output results as JSON",
            "default": false
          }
        },
        "required": ["command"]
      }
    }
  ]
}