{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-frontend-cli",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "options": {
        "cwd": "${workspaceFolder}/buttermilk/frontend/cli/"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Restart Active Debug Session",
      "type": "process",
      "command": "workbench.action.debug.restart",
      "problemMatcher": [],
      "group": {
        "kind": "none", // Or "none", or "build"
        "isDefault": false
      },
      "runOptions": {
        "instanceLimit": 1, // Optional: ensure only one instance runs
        "reevaluateOnRerun": true // Optional
      }
    }
  ]
}
