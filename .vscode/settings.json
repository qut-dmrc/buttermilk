{
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll.ruff": "explicit",
      "source.addMissingImports": "explicit"
    }
  },
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [
    "--override-ini",
    "addopts=",
    // If you also exclude folders via norecursedirs, clear that too:
    "--override-ini",
    "norecursedirs=",
    // Optionally list your test roots (helps discovery):
    "tests"
  ],
  "python.terminal.activateEnvironment": false,
  "editor.defaultFormatter": "charliermarsh.ruff",
  "python.analysis.languageServerMode": "full",
  "python.analysis.include": [
    "buttermilk"
  ],
  "python.analysis.exclude": [
    "**/node_modules",
    "**/__pycache__",
    ".git"
  ],
  "python.analysis.extraPaths": [],
  "python.analysis.diagnosticMode": "workspace",
  "python.analysis.autoSearchPaths": false,
  "python.analysis.useLibraryCodeForTypes": false,
  "python.analysis.indexing": true,
  "python.analysis.autoImportCompletions": true,
  "python.analysis.enablePytestSupport": true,
  "python.analysis.packageIndexDepths": [
    {
      "name": "sklearn",
      "depth": 2
    },
    {
      "name": "matplotlib",
      "depth": 2
    },
    {
      "name": "scipy",
      "depth": 2
    },
    {
      "name": "django",
      "depth": 2
    },
    {
      "name": "flask",
      "depth": 2
    },
    {
      "name": "fastapi",
      "depth": 2
    }
  ],
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "files.exclude": {
    "**/*.backup": true
  },
  "explorer.excludeGitIgnore": true,
  "python-envs.pythonProjects": [],
  "[jinja]": {
    "editor.defaultFormatter": "GlenBuktenica.unicode-substitutions"
  },
  "peacock.remoteColor": "#ecff68",
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#f2ff9b",
    "activityBar.background": "#f2ff9b",
    "activityBar.foreground": "#15202b",
    "activityBar.inactiveForeground": "#15202b99",
    "activityBarBadge.background": "#00a6bf",
    "activityBarBadge.foreground": "#e7e7e7",
    "commandCenter.border": "#15202b99",
    "sash.hoverBorder": "#f2ff9b",
    "statusBar.background": "#ecff68",
    "statusBar.foreground": "#15202b",
    "statusBarItem.hoverBackground": "#e6ff35",
    "statusBarItem.remoteBackground": "#ecff68",
    "statusBarItem.remoteForeground": "#15202b",
    "titleBar.activeBackground": "#ecff68",
    "titleBar.activeForeground": "#15202b",
    "titleBar.inactiveBackground": "#ecff6899",
    "titleBar.inactiveForeground": "#15202b99"
  },
  "peacock.color": "#ecff68",
}
